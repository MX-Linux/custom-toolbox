#!/bin/bash

if ! command -v tx >/dev/null; then
   echo "Transifex CLI (tx) is required to pull translations." >&2
   exit 1
fi

APPNAME="$(basename "$(dirname "$PWD")")-desktop"

echodo() {
  echo "${@}"
  "$@"
}

# prepare transifex 
if [ ! -s  .tx/config ]; then
   mkdir -p .tx
   cat <<EOF > .tx/config
[main]
host = https://www.transifex.com

[o:anticapitalista:p:antix-development:r:$APPNAME]
file_filter = po/${APPNAME}_<lang>.po
source_file = ${APPNAME}.pot
source_lang = en
type = po
EOF
fi

# Pull into the existing catalogs so a failed refresh preserves untouched files.
echodo tx pull -r "antix-development.$APPNAME" --all --force
